{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must equal the Worker name in the Cloudflare dashboard, or Workers Builds fails.
  "name": "gsanchez-me",
  "compatibility_date": "2026-09-28",
  // Static site only: no "main" Worker script and no adapter, so no request is billable.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "gsanchez.me", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Workers Builds runs on non-main branches. Empty is fine.
  "previews": {}
}
