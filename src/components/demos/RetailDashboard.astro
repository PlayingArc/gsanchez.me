---
// Casa Zenzontle demo dashboard (#12). Static shell; src/demos/retail/app.ts draws the data.
import Base from '../../layouts/Base.astro';
import DemoFrame from './DemoFrame.astro';
import { strings } from '../../demos/retail/i18n';
import { data } from '../../demos/retail/model';
import { makeFormat, type Locale } from '../../demos/kit/format';
import '../../styles/demo.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const fmt = makeFormat(locale);
const name = (x: { en: string; es: string }) => x[locale];
const other: Locale = locale === 'en' ? 'es' : 'en';
const path = (l: Locale) => `/${l}/demos/retail/`;
const last = data.months.length - 1;
---

<Base title={t.title} description={t.metaDescription} lang={locale} bodyClass="dz-page" image={`/og/retail-${locale}.png`}>
  <Fragment slot="head">
    <link rel="canonical" href={new URL(path(locale), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(path('en'), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(path('es'), Astro.site)} />
  </Fragment>

  <DemoFrame back={t.frameBack} note={t.frameNote} langLabel={t.frameLang} langHref={path(other)} langCode={other} />

  <main class="dz" data-dash="retail" data-brand="zenzontle" data-locale={locale}>
    <header class="dz-head">
      <div class="dz-brand">
        <svg class="dz-logo" viewBox="0 0 40 40" aria-hidden="true">
          <!-- A zenzontle (mockingbird) on a branch, cut like a stencil. -->
          <path d="M6 27c6 0 9-3 12-8 2-4 5-8 10-8 3 0 5 2 6 4l-4 1c1 3 0 7-3 10-3 3-8 4-13 4l-6 4 2-5-4-2z" />
          <circle cx="29" cy="14.5" r="1.3" fill="var(--z-ground)" />
          <path d="M4 34h32" stroke="currentColor" stroke-width="2" />
        </svg>
        <div>
          <h1>Casa Zenzontle</h1>
          <p>{t.tagline}</p>
        </div>
      </div>
    </header>

    <form class="dz-filters" onsubmit="return false" aria-label={locale === 'en' ? 'Filters' : 'Filtros'}>
      <p class="dz-sentence">
        <span>{t.showing}</span>
        <label class="sr-only" for="f-store">{t.storeFilter}</label>
        <select id="f-store" data-filter="store">
          <option value="">{t.allStores}</option>
          {data.regions.map((r) => (
            <optgroup label={name(r)}>
              <option value={`region:${r.id}`}>{t.regionStores(name(r))}</option>
              {data.stores.filter((s) => s.region === r.id).map((s) => <option value={`store:${s.id}`}>{s.name}</option>)}
            </optgroup>
          ))}
        </select>
        <span>{t.on}</span>
        <label class="sr-only" for="f-channel">{t.channelFilter}</label>
        <select id="f-channel" data-filter="channel">
          <option value="">{t.allChannels}</option>
          <option value="store">{t.channelStore}</option>
          <option value="online">{t.channelOnline}</option>
        </select><span class="dz-comma">,</span>
        <label class="sr-only" for="f-category">{t.categoryFilter}</label>
        <select id="f-category" data-filter="category">
          <option value="">{t.allCategories}</option>
          {data.categories.map((c) => <option value={c.id}>{name(c)}</option>)}
        </select>
        <span data-view="product-chip" hidden></span><span class="dz-comma">,</span>
        <span>{t.from}</span>
        <label class="sr-only" for="f-from">{t.fromFilter}</label>
        <select id="f-from" data-filter="from">
          {data.months.map((m, i) => <option value={i} selected={i === last - 11}>{fmt.month(m)}</option>)}
        </select>
        <span>{t.to}</span>
        <label class="sr-only" for="f-to">{t.toFilter}</label>
        <select id="f-to" data-filter="to">
          {data.months.map((m, i) => <option value={i} selected={i === last}>{fmt.month(m)}</option>)}
        </select><span class="dz-comma">.</span>
      </p>
      <div class="dz-quick">
        <div class="dz-presets" role="group" aria-label={t.presets}>
          <button type="button" data-preset="last3">{t.presetLabels.last3}</button>
          <button type="button" data-preset="last6">{t.presetLabels.last6}</button>
          <button type="button" data-preset="last12">{t.presetLabels.last12}</button>
          <button type="button" data-preset="all">{t.presetLabels.all}</button>
        </div>
        <button type="button" class="dz-reset" data-reset disabled>{t.reset}</button>
      </div>
    </form>

    <noscript><p class="dz-noscript">{t.noscript}</p></noscript>

    <section class="dz-kpi-strip" aria-label={t.kpiNet}>
      <dl class="dz-kpis" data-view="kpis"></dl>
      <p class="dz-period" data-view="kpi-period"></p>
    </section>

    <div class="dz-grid">
      <section class="dz-panel dz-panel--trend">
        <header>
          <h2>{t.trendTitle}</h2>
          <ul class="dz-legend">
            <li><button type="button" data-act="channel:store"><i class="is-store"></i>{t.inStore}</button></li>
            <li><button type="button" data-act="channel:online"><i class="is-online"></i>{t.online}</button></li>
            <li><span><i class="is-target"></i>{t.target}</span></li>
          </ul>
        </header>
        <p class="dz-hint">{t.trendHint}</p>
        <div class="dz-chart" data-view="trend"></div>
      </section>

      <section class="dz-panel dz-panel--stores">
        <header><h2>{t.storesTitle}</h2></header>
        <p class="dz-hint">{t.storesHint}</p>
        <div class="dz-chart" data-view="stores"></div>
      </section>

      <section class="dz-panel dz-panel--drill">
        <header>
          <h2>{t.catTitle}</h2>
          <nav class="dz-crumb" data-view="crumb" aria-label={t.catTitle}></nav>
        </header>
        <p class="dz-hint" data-view="drill-hint">{t.catHint}</p>
        <div class="dz-chart" data-view="drill"></div>
      </section>

      <section class="dz-panel dz-panel--stock">
        <header><h2>{t.stockTitle}</h2></header>
        <p class="dz-hint">{t.stockHint}</p>
        <div class="dz-chart" data-view="stock"></div>
      </section>

      <section class="dz-panel dz-panel--table">
        <header>
          <h2>{t.tableTitle}</h2>
          <div class="dz-toggle" role="group" aria-label={t.rowsBy}>
            <span>{t.rowsBy}</span>
            <button type="button" data-rows="product" aria-pressed="true">{t.rowsProduct}</button>
            <button type="button" data-rows="store" aria-pressed="false">{t.rowsStore}</button>
          </div>
        </header>
        <div class="dz-table-wrap" data-view="table"></div>
      </section>
    </div>

    <footer class="dz-foot">
      <p>{t.footer}</p>
      <a href={`/#work`}>{t.footerLink}</a>
    </footer>
  </main>
</Base>

<script>
  import { mountRetail } from '../../demos/retail/app';
  const root = document.querySelector<HTMLElement>('[data-dash="retail"]');
  if (root) mountRetail(root);
</script>
