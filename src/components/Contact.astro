---
import { profile, site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const t = site(Astro.props.locale);
---

<section class="contact" id="contact" data-theme="green">
  <canvas class="contact__field" data-ascii="contact" aria-hidden="true"></canvas>

  <div class="section__head">
    <span class="pill pill--ink mono">04</span>
    <h2 class="section__title mono">{t.nav.contact}</h2>
  </div>

  <p class="contact__prompt mono" data-scramble>&gt; say --hello</p>
  <a class="contact__email" href={`mailto:${profile.email}`} data-scramble-hover>
    <span data-scramble-target>{profile.email}</span>
  </a>

  <ul class="contact__links">
    {
      t.contact.links.map((l) => (
        <li>
          <a href={l.href} data-scramble-hover target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <span class="mono contact__label">{l.label}</span>
            <span data-scramble-target>{l.handle}</span>
            <span class="mono" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>

  <footer class="footer mono">
    <span>© {new Date().getFullYear()} {profile.firstName} {profile.lastName}</span>
    <span>{t.contact.builtWith}</span>
    <span>{t.contact.palette} <i>Cyberfeminism Index</i> (2023)</span>
    <a href="#top">{t.contact.backToTop}</a>
  </footer>
</section>
