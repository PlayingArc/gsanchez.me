---
import { profile } from '../data/site';

// Staggered indents for the statement lines, in grid columns (of 12).
const indents = [4, 0, 6, 2, 5, 1];
---

<section class="section about" id="about" data-theme="paper">
  <div class="section__head">
    <span class="pill mono">01</span>
    <h2 class="section__title mono">About</h2>
  </div>

  <p class="statement" aria-label={profile.statement.join(' ')}>
    {
      profile.statement.map((line, i) => (
        <span class="statement__line" style={`--indent:${indents[i % indents.length]}`} data-reveal data-delay={i * 160} aria-hidden="true">
          <span data-scramble-child>{line}</span>
        </span>
      ))
    }
  </p>

  <div class="about__body">
    <div class="about__text">
      {profile.about.map((p) => <p data-reveal>{p}</p>)}
    </div>
    <dl class="about__now">
      {
        profile.now.map(([k, v]) => (
          <div>
            <dt class="mono">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
