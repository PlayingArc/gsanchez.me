---
// Static stand-in for a language redirect: picks /es/… when the browser prefers Spanish, else /en/….
// Keeps the query string and hash so shared links survive. The links are the no-JS fallback.
interface Props {
  path: string; // the page under each language, e.g. '/' or '/demos/retail'
  title: string;
}
const { path, title } = Astro.props;
const en = `/en${path}`;
const es = `/es${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="alternate" hreflang="en" href={new URL(en, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(es, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <script is:inline define:vars={{ en, es }}>
      const langs = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
      const first = langs.find((l) => /^(en|es)\b/i.test(l)) ?? 'en';
      location.replace((/^es/i.test(first) ? es : en) + location.search + location.hash);
    </script>
  </head>
  <body>
    <p><a href={en}>English</a> / <a href={es} lang="es">Español</a></p>
  </body>
</html>
