---
import { projects } from '../data/site';
import { renderDash } from '../scripts/dashboards';

// How each set sits in the stack: size relative to the wall's base height,
// side-panel width, and casing finish. The first two sit on top.
const sets = [
  { f: 1.12, panel: 0.34, casing: 'graphite', knobs: 2 },
  { f: 0.92, panel: 0.3, casing: 'plastic', knobs: 1 },
  { f: 1, panel: 0.36, casing: 'charcoal', knobs: 2 },
  { f: 1, panel: 0.28, casing: 'plastic', knobs: 1 },
  { f: 1, panel: 0.4, casing: 'graphite', knobs: 3 },
];
const rows = [projects.slice(0, 2), projects.slice(2, 5)];
---

<section class="work" id="work" data-theme="black">
  <div class="section work__intro">
    <div class="section__head">
      <span class="pill mono">03</span>
      <h2 class="section__title mono">Work</h2>
      <span class="section__aside mono">{String(projects.length).padStart(2, '0')} live demos</span>
    </div>

    <div class="wall" data-wall>
      {
        rows.map((row, r) => (
          <div class:list={['wall__row', r === 0 && 'wall__row--top']}>
            {row.map((p) => {
              const i = projects.indexOf(p);
              const set = sets[i % sets.length];
              return (
                <a
                  class={`tv tv--${set.casing}`}
                  href={p.href}
                  style={`--f:${set.f}; --panel:${set.panel}`}
                  data-tv={i}
                  data-preview={p.preview}
                  aria-label={`${p.title} — open the demo`}
                >
                  <span class="tv__case">
                    <span class="tv__screen">
                      <span class="tv__img" data-dash set:html={renderDash(p.preview, 0)} />
                      <span class="tv__fx" aria-hidden="true" />
                    </span>
                    <span class="tv__panel" aria-hidden="true">
                      {Array.from({ length: set.knobs }, (_, k) => (
                        <span class:list={['tv__knob', k > 0 && 'tv__knob--sm']} />
                      ))}
                      <span class="tv__grille" />
                      <span class="tv__led" />
                    </span>
                    <span class="tv__plate mono" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')} · {p.title}
                    </span>
                  </span>
                  <span class="tv__feet" aria-hidden="true" />
                </a>
              );
            })}
          </div>
        ))
      }
    </div>

    <div class="wall__caption" aria-live="polite">
      {
        projects.map((p, i) => (
          <article class="panel" data-panel={i} hidden={i !== 0}>
            <p class="panel__kind mono">
              <span data-scramble-child>{p.kind}</span> · {p.year}
            </p>
            <h3 class="panel__title">
              <span data-scramble-child>{p.title}</span>
            </h3>
            <p class="panel__summary">{p.summary}</p>
            <ul class="tags" aria-label="Stack">
              {p.stack.map((s) => (
                <li class="pill pill--glow mono">{s}</li>
              ))}
            </ul>
            <p class="panel__links mono">
              <a href={p.href} data-launch={i}>
                Step inside ↗
              </a>
              {p.repo && <a href={p.repo}>Source</a>}
            </p>
          </article>
        ))
      }
      <p class="wall__hint mono">Hover a screen · click to step inside</p>
    </div>
  </div>

  <div class="section work__index">
    <div class="section__head">
      <span class="pill mono">03.1</span>
      <h2 class="section__title mono">Index</h2>
    </div>
    <table class="table">
      <thead class="mono">
        <tr>
          <th scope="col">No.</th>
          <th scope="col">Project</th>
          <th scope="col">Type</th>
          <th scope="col" class="table__stack">Stack</th>
          <th scope="col">Year</th>
          <th scope="col"><span class="sr-only">Link</span></th>
        </tr>
      </thead>
      <tbody>
        {
          projects.map((p, i) => (
            <tr data-reveal data-delay={i * 60}>
              <td class="mono">{String(i + 1).padStart(2, '0')}</td>
              <th scope="row">
                <a href={p.href} data-scramble-hover data-launch={i}>
                  <span data-scramble-target>{p.title}</span>
                </a>
              </th>
              <td class="mono">{p.kind}</td>
              <td class="mono table__stack">{p.stack.join(' / ')}</td>
              <td class="mono">{p.year}</td>
              <td class="mono table__go" aria-hidden="true">↗</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
