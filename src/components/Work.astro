---
import { site, type Locale } from '../data/site';
import { renderDash } from '../scripts/dashboards';
import '../styles/screens.css';

interface Props {
  locale: Locale;
}
const t = site(Astro.props.locale);
const projects = t.work.projects;

// How big each TV is relative to the wall's base height. The first two sit on
// top of the other two, so they are a little smaller.
const sizes = [0.9, 0.97, 1.06, 1];
const rows = [projects.slice(0, 2), projects.slice(2, 4)];
---

<section class="work" id="work" data-theme="black">
  <div class="section work__intro">
    <div class="section__head">
      <span class="pill mono">03</span>
      <h2 class="section__title mono">{t.nav.work}</h2>
      <span class="section__aside mono">{String(projects.length).padStart(2, '0')} {t.work.liveDemos}</span>
    </div>

    <div class="wall" data-wall>
      {
        rows.map((row, r) => (
          <div class:list={['wall__row', r === 0 && 'wall__row--top']}>
            {row.map((p) => {
              const i = projects.indexOf(p);
              return (
                <a
                  class="tv"
                  href={p.href}
                  style={`--f:${sizes[i] ?? 1}`}
                  data-tv={i}
                  data-preview={p.preview}
                  aria-label={`${p.title} — ${t.work.open}`}
                >
                  <span class="tv__screen">
                    <span class="tv__img" data-dash set:html={renderDash(p.preview, Astro.props.locale)} />
                    <span class="tv__fx" aria-hidden="true" />
                  </span>
                  <img class="tv__body" src="/tv/field-black.webp" width="1200" height="980" alt="" loading="lazy" decoding="async" />
                  <img class="tv__glass" src="/tv/field-black-glass.webp" width="1200" height="980" alt="" loading="lazy" decoding="async" />
                </a>
              );
            })}
          </div>
        ))
      }
    </div>

    <div class="wall__caption" aria-live="polite">
      {
        projects.map((p, i) => (
          <article class="panel" data-panel={i} hidden={i !== 0}>
            <p class="panel__kind mono">
              <span data-scramble-child>{p.kind}</span> · {p.year}
            </p>
            <h3 class="panel__title">
              <span data-scramble-child>{p.title}</span>
            </h3>
            <p class="panel__summary">{p.summary}</p>
            <ul class="tags" aria-label={t.work.stackLabel}>
              {p.stack.map((s) => (
                <li class="pill pill--glow mono">{s}</li>
              ))}
            </ul>
            <p class="panel__links mono">
              <a href={p.href} data-launch={i}>
                {t.work.stepInside}
              </a>
              {p.repo && <a href={p.repo}>{t.work.source}</a>}
            </p>
          </article>
        ))
      }
      <p class="wall__hint mono">{t.work.hint}</p>
    </div>
  </div>

  <div class="section work__index">
    <div class="section__head">
      <span class="pill mono">03.1</span>
      <h2 class="section__title mono">{t.work.index}</h2>
    </div>
    <table class="table">
      <thead class="mono">
        <tr>
          <th scope="col">{t.work.cols.no}</th>
          <th scope="col">{t.work.cols.project}</th>
          <th scope="col">{t.work.cols.type}</th>
          <th scope="col" class="table__stack">{t.work.cols.stack}</th>
          <th scope="col">{t.work.cols.year}</th>
          <th scope="col"><span class="sr-only">{t.work.cols.link}</span></th>
        </tr>
      </thead>
      <tbody>
        {
          projects.map((p, i) => (
            <tr data-reveal data-delay={i * 60}>
              <td class="mono">{String(i + 1).padStart(2, '0')}</td>
              <th scope="row">
                <a href={p.href} data-scramble-hover data-launch={i}>
                  <span data-scramble-target>{p.title}</span>
                </a>
              </th>
              <td class="mono">{p.kind}</td>
              <td class="mono table__stack">{p.stack.join(' / ')}</td>
              <td class="mono">{p.year}</td>
              <td class="mono table__go" aria-hidden="true">↗</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
