---
import { otherLocale, profile, site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = site(locale);
const other = otherLocale(locale);

const nav = [
  [t.nav.about, '#about'],
  [t.nav.experience, '#experience'],
  [t.nav.work, '#work'],
  [t.nav.contact, '#contact'],
];
---

<header class="header" data-header data-on="green">
  <a class="header__mark mono" href="#top" data-scramble-hover>
    <span data-scramble-target>{profile.firstName[0]}{profile.lastName[0]}/PORTFOLIO</span>
  </a>
  {
    profile.available && (
      <p class="header__status mono">
        <span class="dot" aria-hidden="true" /> {t.header.status}
      </p>
    )
  }
  <nav class="header__nav mono" aria-label={t.hero.onThisPage}>
    {
      nav.map(([label, href]) => (
        <a href={href} data-scramble-hover>
          <span data-scramble-target>{label}</span>
        </a>
      ))
    }
  </nav>
  <div class="header__end">
    <a class="header__lang mono" href={`/${other}/`} hreflang={other} lang={other} aria-label={site(other).langName}>
      {site(other).switchLabel}
    </a>
    <a class="header__cta" href={`mailto:${profile.email}`}>{t.header.cta}</a>
  </div>
</header>
