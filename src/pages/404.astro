---
// One 404 for every path, so it speaks both languages; each link goes home in its own.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const en = site('en').notFound;
const es = site('es').notFound;
---

<Base title={`${en.title} · ${es.title}`}>
  <main class="not-found">
    <p class="mono">{en.kicker}</p>
    <h1>{en.heading}</h1>
    <p lang="es">{es.heading}</p>
    <p class="mono">
      <a href="/en/">{en.back}</a><br />
      <a href="/es/" lang="es">{es.back}</a>
    </p>
  </main>
</Base>

<style>
  .not-found {
    min-height: 100svh;
    display: grid;
    place-content: center;
    gap: 16px;
    padding: var(--gutter);
    background: var(--black);
    color: var(--paper);
  }
  h1 { font-size: clamp(32px, 6vw, 72px); line-height: 1; color: var(--green); }
  a { color: var(--green); }
</style>
